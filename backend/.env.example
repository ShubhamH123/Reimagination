# Copy this file to .env and fill in your own values. Never commit .env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=change-me-to-a-long-random-string
PORT=8000

# Admin panel login (used by POST /api/admin/login)
ADMIN_EMAIL=admin@techneeds.dev
ADMIN_PASSWORD=change-me

# Optional: enables LLM-written profile summaries (the app falls back to a built-in rules engine without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
